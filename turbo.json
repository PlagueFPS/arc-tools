{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "env": ["DISCORD_APPLICATION_ID"],
      "inputs": ["$TURBO_DEFAULT$", ".env", ".env.*"],
      "outputs": ["dist/**", ".output/**"]
    },
    "dev": {
      "env": ["DISCORD_APPLICATION_ID"],
      "cache": false,
      "persistent": true
    },
    "typecheck": {
      "dependsOn": [],
      "outputs": []
    },
    "test": {
      "dependsOn": [],
      "env": ["DISCORD_APPLICATION_ID"],
      "outputs": []
    },
    "//#lint": {},
    "//#lint:fix": {
      "cache": false
    },
    "//#fmt": {},
    "//#fmt:fix": {
      "cache": false
    }
  }
}
