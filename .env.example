ARC_STAGE=local-yourname
APPLICATION_STAGE=local-yourname
ARC_ENVIRONMENT=bot
ARC_BUILD_REVISION=unreleased
ARC_PUBLIC_URL=https://your-bot-tunnel.example.com
TWITCH_SENDER_KIND=bot
TWITCH_SENDER_LOGIN=your_test_bot_login
TWITCH_CHANNEL_LOGINS=your_test_channel_login
TWITCH_CLIENT_ID=replace-with-this-environments-client-id
TWITCH_CLIENT_SECRET=replace-with-this-environments-client-secret
TWITCH_SIGNING_SECRET=replace-with-this-environments-signing-secret
DISCORD_APPLICATION_ID=replace-with-this-environments-application-id
DISCORD_PUBLIC_KEY=replace-with-this-environments-64-hex-public-key
DISCORD_BOT_TOKEN=replace-with-this-environments-bot-token
OPERATOR_SECRET=replace-with-this-environments-operator-secret
