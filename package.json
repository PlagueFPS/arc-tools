{
  "name": "arc-tools",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "packageManager": "bun@1.3.5",
  "scripts": {
    "build": "turbo run build",
    "test": "turbo run test && bun --no-env-file test ./tests/cloud/fixture-http.test.ts ./tests/cloud/fixture-response.test.ts ./tests/cloud/alarm-attribution.test.ts ./scripts/local.test.ts ./scripts/preview.test.ts ./scripts/preview-workflows.test.ts",
    "dev": "alchemy dev",
    "dev:local": "bun run scripts/local.ts dev",
    "setup:local": "bun run scripts/local.ts setup",
    "status:local": "bun run scripts/local.ts status",
    "sync:discord:local": "bun run scripts/local.ts sync",
    "lint": "turbo run format-and-lint",
    "format-and-lint": "oxlint --deny-warnings . && oxfmt --check .",
    "format-and-lint:fix": "oxlint --fix . && oxfmt --write .",
    "check-types": "turbo run check-types && tsc --noEmit",
    "test:cloud": "bun run scripts/cloud-test.ts",
    "test:cloud:cleanup": "bun run scripts/cloud-test.ts cleanup",
    "deploy": "alchemy deploy",
    "ops": "bun run scripts/ops.ts",
    "sync:discord": "bun run scripts/sync-discord-commands.ts",
    "preview:deploy": "bun --no-env-file run scripts/preview.ts deploy",
    "preview:cleanup": "bun --no-env-file run scripts/preview.ts cleanup"
  },
  "devDependencies": {
    "@effect/language-service": "^0.77.0",
    "turbo": "^2.8.15",
    "typescript": "5.9.3",
    "alchemy": "2.0.0-beta.83",
    "effect": "4.0.4",
    "@types/bun": "1.3.5",
    "@cloudflare/workers-types": "5.20261015.1",
    "@effect/platform-bun": "4.0.4",
    "@effect/platform-node": "4.0.4",
    "@distilled.cloud/cloudflare": "1.0.0-rc.15",
    "oxlint": "1.88.0",
    "oxfmt": "0.73.0"
  },
  "overrides": {
    "@effect/platform-node-shared": "4.0.4",
    "@effect/sql-sqlite-do": "4.0.4",
    "@effect/sql-d1": "4.0.4"
  },
  "type": "module"
}
