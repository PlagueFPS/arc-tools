{
  "name": "arc-tools",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "packageManager": "bun@1.4.2",
  "scripts": {
    "build": "turbo run build",
    "test": "turbo run test",
    "dev": "turbo run dev",
    "lint": "turbo run format-and-lint",
    "format-and-lint": "biome check .",
    "format-and-lint:fix": "biome check . --write",
    "check-types": "turbo run check-types",
    "dev:worker": "bun run --cwd apps/worker dev",
    "verify:worker": "turbo run verify:worker --filter=@arctools/worker",
    "provision:discord": "bun run --cwd apps/worker provision:discord",
    "provision:twitch": "bun run --cwd apps/worker provision:twitch"
  },
  "devDependencies": {
    "@biomejs/biome": "2.3.15",
    "@effect/language-service": "^0.77.0",
    "@effect/vitest": "4.0.4",
    "turbo": "^2.8.15",
    "typescript": "5.9.3",
    "vitest": "5.0.4"
  }
}
