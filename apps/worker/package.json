{
  "name": "@arctools/worker",
  "version": "0.0.0",
  "type": "module",
  "private": true,
  "scripts": {
    "build": "bun scripts/build.ts",
    "dev": "alchemy dev alchemy.run.ts",
    "check-types": "tsc --noEmit",
    "test": "vitest run --exclude test/worker.test.ts",
    "verify:worker": "bun run build && vitest run test/worker.test.ts",
    "provision:discord": "bun --env-file ../../.env scripts/provision.ts discord",
    "provision:twitch": "bun --env-file ../../.env scripts/provision.ts twitch"
  },
  "dependencies": {
    "@arctools/commands": "workspace:*",
    "alchemy": "2.0.0-beta.83",
    "effect": "4.0.4"
  },
  "devDependencies": {
    "@arctools/typescript-config": "workspace:*",
    "@effect/platform-bun": "4.0.4",
    "@cloudflare/workers-types": "5.20261013.1",
    "@types/bun": "1.3.5",
    "miniflare": "5.20261006.1-alpha",
    "vitest": "5.0.4",
    "typescript": "5.9.3",
    "@effect/platform-node": "4.0.4"
  }
}
